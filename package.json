{
  "name": "@jidekaixin2dian/dsh-run-receipt",
  "version": "0.1.0-beta.1",
  "description": "DSH inbox for scheduled runs, exact turn outcomes, and workspace report checks.",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "icon.svg",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "test": "node --test",
    "prepack": "npm run build"
  },
  "author": "jidekaixin2dian",
  "license": "MIT",
  "icon": "icon.svg",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "schedule",
    "automation"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jidekaixin2dian/dsh-run-receipt.git"
  },
  "homepage": "https://github.com/jidekaixin2dian/dsh-run-receipt#readme",
  "bugs": "https://github.com/jidekaixin2dian/dsh-run-receipt/issues",
  "engines": {
    "node": ">=24",
    "dsh": ">=0.2.2-rc.1 <0.2.3"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-workspace",
        "@deepseek-ai/dsh-api-workspace-controller",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "marked": "17.0.5"
  }
}
